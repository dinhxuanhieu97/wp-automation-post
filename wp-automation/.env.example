# ============================================================
# WP AUTOMATION - dienmaykimbien.com.vn
# Sao chép file này thành `.env` và điền giá trị thật.
# TUYỆT ĐỐI không commit file .env lên git.
# ============================================================

# ---------- WordPress REST API ----------
# Tạo Application Password: WP Admin > Users > Profile > Application Passwords
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ---------- WP Admin (dùng cho Playwright login /wp-admin) ----------
WP_ADMIN_USERNAME=admin
WP_ADMIN_PASSWORD=your-admin-password

# ---------- LLM ----------
# CÁCH 1 (khuyến nghị nếu có gói Claude Pro/Max): dùng Claude Code CLI, KHÔNG tốn phí API.
#   Cài:   npm install -g @anthropic-ai/claude-code
#   Login: claude   (đăng nhập 1 lần bằng tài khoản Max)
#   config.json để provider "claude_cli" là xong — không cần key nào bên dưới.
# Đường dẫn binary nếu `claude` không nằm trong PATH:
CLAUDE_CLI_BIN=claude

# CÁCH 2 (fallback / chạy server không login được): API key, tính phí theo token.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- Media APIs ----------
PEXELS_API_KEY=xxxxxxxx
UNSPLASH_ACCESS_KEY=xxxxxxxx

# ---------- Keyword APIs (tuỳ chọn) ----------
SERPAPI_KEY=

# ---------- Misc ----------
# Ghi đè trạng thái đăng bài: draft | publish | schedule
POST_STATUS_OVERRIDE=
# Chạy 1 lần rồi thoát (không bật scheduler): true | false
RUN_ONCE=false
